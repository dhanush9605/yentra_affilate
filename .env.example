# Environment Variables Template — YENTRA
# Copy this file to .env.local and fill in your values

# ──────────────────────────────────────────────────────────────────────────────
# Amazon Associates — India (Primary)
# ──────────────────────────────────────────────────────────────────────────────
# Leave empty until your official Amazon Associates India account is approved.
# When approved, set your assigned tag here (e.g. yourtag-21).
AMAZON_IN_ASSOCIATE_TAG=
NEXT_PUBLIC_AMAZON_IN_ASSOCIATE_TAG=

# ──────────────────────────────────────────────────────────────────────────────
# Site Configuration
# ──────────────────────────────────────────────────────────────────────────────
# Centralized site URL and contact email
NEXT_PUBLIC_SITE_URL=https://yendra.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@yendra.com

# ──────────────────────────────────────────────────────────────────────────────
# Analytics (optional)
# ──────────────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_GA4_ID=
